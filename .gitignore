# Real secrets never get committed — only *.env.example (placeholders).
.env
*.env
!*.env.example
!*.env.example.extra
!*.env.sample

# Real credential material for the identity stack.
identity/authelia/config/

# The alertmanager SMTP password file (referenced by path, not by value).
monitoring/alertmanager/smtp_password

