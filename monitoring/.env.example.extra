# Extra keys/values for monitoring/.env.example.
#
# GOTIFY_DEFAULTUSER_PASS: IS scanned from docker-compose.yaml (it's a
# ${VAR:?required} there), but a required-var clause carries no default value
# for the generator to read — this just supplies a friendlier placeholder
# than blank, and (see tools/check-compose.sh) lets a CI run's throwaway .env,
# seeded from this file, actually satisfy the :? check instead of failing it.
GOTIFY_DEFAULTUSER_PASS=changeme-long-random
