# Extra values for analytics/.env.example.
#
# All three are ${VAR:?required} in docker-compose.yaml, and a required-var clause
# carries no default for the generator to read. This supplies a friendlier
# placeholder than blank and (see tools/check-compose.sh) lets a CI run's throwaway
# .env, seeded from this file, satisfy the :? check. Same pattern as
# monitoring/.env.example.extra.
PLAUSIBLE_DB_PASS=changeme-long-random
# SECRET_KEY_BASE: >= 64 bytes. Generate with: openssl rand -base64 48
PLAUSIBLE_SECRET_KEY_BASE=changeme-at-least-64-bytes-of-random-base64-changeme-changeme-changeme
# TOTP_VAULT_KEY: 32 bytes, base64. Generate with: openssl rand -base64 32
# Losing it invalidates enrolled 2FA secrets.
PLAUSIBLE_TOTP_VAULT_KEY=changeme-32-bytes-base64-changeme=
